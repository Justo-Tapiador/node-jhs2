<nav>
  <ul style="list-style:none; display:flex; gap:1rem; padding:0;">
    <?jhs
      const links = [
        { href: '/', label: 'Home' },
        { href: '/about', label: 'About' }
      ];
      links.forEach(link => {
    ?>
      <li>
        <a href="<?= link.href ?>"
           <?jhs if (active === link.label.toLowerCase()) { ?>
             style="font-weight:bold;"
           <?jhs } ?>
        ><?= link.label ?></a>
      </li>
    <?jhs }); ?>
  </ul>
</nav>
